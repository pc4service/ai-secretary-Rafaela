# ============================================================
# AI Secretary Agent – Environment Variables
# Copy this file to .env and fill in the values
# ============================================================

# App
ENVIRONMENT=trial
DEBUG=true
DRY_RUN=true
SECRET_KEY=change-this-to-a-long-random-string-in-production

# LLM (required for the agent to work)
OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini

# Firecrawl (optional for research tool)
FIRECRAWL_API_KEY=fc-...

# Microsoft 365 OAuth (Phase 1)
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_TENANT_ID=common
MS_REDIRECT_URI=http://localhost:8000/api/v1/auth/microsoft/callback

# Google OAuth (Phase 1)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# Database (defaults work with docker-compose)
DATABASE_URL=postgresql+asyncpg://secretary:secretary@db:5432/secretary
REDIS_URL=redis://redis:6379/0

# GDPR
DEFAULT_RETENTION_DAYS=30
AUDIT_LOG_RETENTION_DAYS=365

# --- User login (Sign-In OAuth) – separate from mail/calendar integration ---
GOOGLE_LOGIN_REDIRECT_URI=http://localhost:8000/api/v1/login/google/callback
MS_LOGIN_REDIRECT_URI=http://localhost:8000/api/v1/login/microsoft/callback
FRONTEND_URL=http://localhost:3000
COOKIE_SECURE=false
COOKIE_NAME=rafaela_session
