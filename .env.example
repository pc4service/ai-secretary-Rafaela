# ============================================================
# AI Secretary Agent – Environment Variables
# Copy this file to .env and fill in the values
# ============================================================

# App
ENVIRONMENT=trial
DEBUG=true
DRY_RUN=true
SECRET_KEY=change-this-to-a-long-random-string-in-production

# LLM — official OpenAI is primary (empty OPENAI_BASE_URL)
OPENAI_API_KEY=sk-...
OPENAI_BASE_URL=
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=120

# ChatGPT OAuth (Settings → Σύνδεση OpenAI). Callback: http://localhost:1455/auth/callback
OPENAI_OAUTH_REDIRECT_URI=http://localhost:1455/auth/callback
OPENAI_OAUTH_MODEL=gpt-5.5

# OpenCode backup (optional)
OPENCODE_API_KEY=
OPENCODE_BASE_URL=https://opencode.ai/zen/go/v1
OPENCODE_MODEL=kimi-k3

# --- Multi-provider failover ---
# Format: name|model|base_url|ENV_VAR ; name2|…
# Empty base_url = official OpenAI. Hops without a real key are skipped.
LLM_FAILOVER_CHAIN=openai|gpt-4o-mini||OPENAI_API_KEY;opencode|kimi-k3|https://opencode.ai/zen/go/v1|OPENCODE_API_KEY
#
# Extra slots (auto chain if LLM_FAILOVER_CHAIN is empty):
XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1
XAI_MODEL=grok-3-mini
OPENAI_FALLBACK_API_KEY=
OPENAI_FALLBACK_MODEL=gpt-4o-mini

# Firecrawl (optional for research tool)
FIRECRAWL_API_KEY=fc-...

# Microsoft 365 OAuth (Phase 1)
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_TENANT_ID=common
MS_REDIRECT_URI=http://localhost:8000/api/v1/auth/microsoft/callback

# Google OAuth (Phase 1)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# Database (defaults work with docker-compose)
DATABASE_URL=postgresql+asyncpg://secretary:secretary@db:5432/secretary
REDIS_URL=redis://redis:6379/0

# GDPR
DEFAULT_RETENTION_DAYS=30
AUDIT_LOG_RETENTION_DAYS=365

# --- User login (Sign-In OAuth) – separate from mail/calendar integration ---
GOOGLE_LOGIN_REDIRECT_URI=http://localhost:8000/api/v1/login/google/callback
MS_LOGIN_REDIRECT_URI=http://localhost:8000/api/v1/login/microsoft/callback
FRONTEND_URL=http://localhost:3000
COOKIE_SECURE=false
COOKIE_NAME=rafaela_session

# Knowledge / RAG
KNOWLEDGE_DIR=/knowledge
QDRANT_URL=http://qdrant:6333
KNOWLEDGE_TOP_K=5
KNOWLEDGE_EMBED_MODEL=text-embedding-3-small
