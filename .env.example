# ============================================================
# AI Secretary Agent – Environment Variables
# Copy this file to .env and fill in the values
# ============================================================

# App
ENVIRONMENT=trial
DEBUG=true
DRY_RUN=true
SECRET_KEY=change-this-to-a-long-random-string-in-production

# LLM — brain of Rafaela (separate from Microsoft 365 mail/calendar OAuth)
# Option A: official OpenAI Platform key (sk-proj-… or sk-…)
OPENAI_API_KEY=sk-...
OPENAI_BASE_URL=
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=120
# Option B: ChatGPT OAuth from Settings (no Platform key) — see OPENAI_OAUTH_*
# Option C: OPENCODE_API_KEY backup below
# Microsoft 365 connection does NOT provide an LLM.

# ChatGPT OAuth (Settings → Σύνδεση OpenAI). Callback: http://localhost:1455/auth/callback
OPENAI_OAUTH_REDIRECT_URI=http://localhost:1455/auth/callback
OPENAI_OAUTH_MODEL=gpt-5.5
# low avoids Codex cutting long reasoning with: Response incomplete: max_time_limit
OPENAI_OAUTH_REASONING_EFFORT=low

# Agent latency (intent router + step cap)
AGENT_INTENT_ROUTER=true
AGENT_MAX_STEPS=4

# OpenCode backup (optional)
OPENCODE_API_KEY=
OPENCODE_BASE_URL=https://opencode.ai/zen/go/v1
OPENCODE_MODEL=kimi-k3

# --- Multi-provider failover ---
# Format: name|model|base_url|ENV_VAR ; name2|…
# Empty base_url = official OpenAI. Hops without a real key are skipped.
LLM_FAILOVER_CHAIN=xai|grok-3-mini|https://api.x.ai/v1|XAI_API_KEY;gemini|gemini-2.0-flash|https://generativelanguage.googleapis.com/v1beta/openai/|GEMINI_API_KEY;opencode|kimi-k3|https://opencode.ai/zen/go/v1|OPENCODE_API_KEY;openai|gpt-4o-mini||OPENAI_API_KEY
#
# Extra slots (auto chain if LLM_FAILOVER_CHAIN is empty):
XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1
XAI_MODEL=grok-3-mini
# Google Gemini (OpenAI-compatible endpoint)
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_MODEL=gemini-2.0-flash
OPENAI_FALLBACK_API_KEY=
OPENAI_FALLBACK_MODEL=gpt-4o-mini

# Firecrawl (optional for research tool)
FIRECRAWL_API_KEY=fc-...

# Microsoft 365 OAuth (Phase 1)
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_TENANT_ID=common
MS_REDIRECT_URI=http://localhost:8000/api/v1/auth/microsoft/callback

# Google OAuth (Phase 1)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# Database (defaults work with docker-compose)
DATABASE_URL=postgresql+asyncpg://secretary:secretary@db:5432/secretary
REDIS_URL=redis://redis:6379/0

# GDPR
DEFAULT_RETENTION_DAYS=30
AUDIT_LOG_RETENTION_DAYS=365

# --- User login (Sign-In OAuth) – separate from mail/calendar integration ---
GOOGLE_LOGIN_REDIRECT_URI=http://localhost:8000/api/v1/login/google/callback
MS_LOGIN_REDIRECT_URI=http://localhost:8000/api/v1/login/microsoft/callback
FRONTEND_URL=http://localhost:3000
COOKIE_SECURE=false
COOKIE_NAME=rafaela_session
# Browser origins allowed to call the API with the session cookie.
# FRONTEND_URL is added automatically. In production, loopback origins are
# dropped, so set this to the real host(s).
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]
# Refuse the anonymous "demo-user" fallback on user-scoped endpoints.
# Always enforced when ENVIRONMENT=production, whatever this is set to.
REQUIRE_AUTH=false

# Rate limiting (counted in Redis so all workers share one budget)
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60
# Reverse proxies in front of the app. 0 = none, so X-Forwarded-For is ignored
# (a client could spoof it to dodge the limit). Behind the bundled nginx set 1;
# behind Cloudflare -> nginx set 2. Leaving this at 0 behind a proxy makes every
# user share one bucket, because they all appear as the proxy's address.
TRUSTED_PROXY_HOPS=0

# Knowledge / RAG
KNOWLEDGE_DIR=/knowledge
QDRANT_URL=http://qdrant:6333
KNOWLEDGE_TOP_K=5
KNOWLEDGE_EMBED_MODEL=text-embedding-3-small
