# =============================================================================
# Rafaela – LOCAL production-mode template (your PC, not a public VPS)
#
#   cp .env.prod.local.example .env.prod
#   # fill secrets (or: ./scripts/local_prod.sh init)
#   ./scripts/local_prod.sh up
#
# Uses HTTP on 127.0.0.1 → COOKIE_SECURE must stay false.
# Demo login is OFF (ENVIRONMENT=production). Use Microsoft login.
# Keep DRY_RUN=true until you explicitly want real calendar writes.
# Never commit .env.prod.
# =============================================================================

ENVIRONMENT=production
DEBUG=false
DRY_RUN=true
REQUIRE_AUTH=true
# false: browser is on http://127.0.0.1 (Secure cookies need HTTPS)
COOKIE_SECURE=false
COOKIE_NAME=rafaela_session

SECRET_KEY=CHANGE_ME_GENERATE_WITH_openssl_rand_hex_32
ENCRYPTION_KEY=

# Use localhost everywhere (not 127.0.0.1) so the session cookie sticks after MS OAuth.
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# --- LLM ---
OPENAI_API_KEY=
OPENAI_BASE_URL=
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=180
OPENAI_OAUTH_REDIRECT_URI=http://localhost:1455/auth/callback
OPENAI_OAUTH_MODEL=gpt-5.5
OPENAI_OAUTH_REASONING_EFFORT=low
OPENCODE_API_KEY=
OPENCODE_BASE_URL=https://opencode.ai/zen/go/v1
OPENCODE_MODEL=kimi-k3
# xai / gemini / opencode / openai — hops without a real key are skipped
LLM_FAILOVER_CHAIN=xai|grok-3-mini|https://api.x.ai/v1|XAI_API_KEY;gemini|gemini-3.6-flash|https://generativelanguage.googleapis.com/v1beta/openai/|GEMINI_API_KEY;opencode|kimi-k3|https://opencode.ai/zen/go/v1|OPENCODE_API_KEY;openai|gpt-4o-mini||OPENAI_API_KEY
XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1
XAI_MODEL=grok-3-mini
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_MODEL=gemini-3.6-flash

AGENT_INTENT_ROUTER=true
AGENT_MAX_STEPS=4

FIRECRAWL_API_KEY=

# --- Microsoft (required for local prod login — demo is disabled) ---
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_TENANT_ID=common
MS_REDIRECT_URI=http://localhost:8000/api/v1/auth/microsoft/callback
MS_LOGIN_REDIRECT_URI=http://localhost:8000/api/v1/login/microsoft/callback

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback
GOOGLE_LOGIN_REDIRECT_URI=http://localhost:8000/api/v1/login/google/callback

# --- DB / Redis (compose service names) ---
POSTGRES_USER=secretary
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
POSTGRES_DB=secretary
DATABASE_URL=postgresql+asyncpg://secretary:CHANGE_ME_STRONG_DB_PASSWORD@db:5432/secretary
REDIS_URL=redis://redis:6379/0

RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60
TRUSTED_PROXY_HOPS=0

KNOWLEDGE_DIR=/knowledge
QDRANT_URL=http://qdrant:6333
KNOWLEDGE_TOP_K=5
KNOWLEDGE_EMBED_MODEL=text-embedding-3-small

DEFAULT_RETENTION_DAYS=30
AUDIT_LOG_RETENTION_DAYS=365
