# =============================================================================
# Rafaela – Production environment template
# Copy to .env.prod and fill in ALL required values before:
#   docker compose -f docker-compose.prod.yml --env-file .env.prod up -d --build
# =============================================================================

# --- App ---
ENVIRONMENT=production
DEBUG=false
# Set false only after HITL + OAuth are verified
DRY_RUN=true
SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_STRING_AT_LEAST_32_CHARS
# Optional dedicated Fernet key (url-safe base64 32 bytes). If empty, derived from SECRET_KEY.
ENCRYPTION_KEY=

# --- LLM (required) ---
OPENAI_API_KEY=sk-...
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini

# --- Firecrawl (optional) ---
FIRECRAWL_API_KEY=

# --- Microsoft 365 OAuth ---
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_TENANT_ID=common
# Use your public HTTPS URLs in production
MS_REDIRECT_URI=https://api.yourdomain.com/api/v1/auth/microsoft/callback

# --- Google OAuth ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://api.yourdomain.com/api/v1/auth/google/callback

# --- Database (must match compose) ---
POSTGRES_USER=secretary
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
POSTGRES_DB=secretary
DATABASE_URL=postgresql+asyncpg://secretary:CHANGE_ME_STRONG_DB_PASSWORD@db:5432/secretary

# --- Redis ---
REDIS_PASSWORD=
# If REDIS_PASSWORD is set, use:
# REDIS_URL=redis://:YOUR_PASSWORD@redis:6379/0
REDIS_URL=redis://redis:6379/0

# --- Frontend (baked at build time) ---
# URL the BROWSER uses to call the API (public origin)
NEXT_PUBLIC_API_URL=https://api.yourdomain.com

# --- GDPR ---
DEFAULT_RETENTION_DAYS=30
AUDIT_LOG_RETENTION_DAYS=365

# --- CORS (set in app if you extend config) ---
# Prefer restricting to your frontend origin in production code

# User Sign-In
GOOGLE_LOGIN_REDIRECT_URI=https://api.yourdomain.com/api/v1/login/google/callback
MS_LOGIN_REDIRECT_URI=https://api.yourdomain.com/api/v1/login/microsoft/callback
FRONTEND_URL=https://app.yourdomain.com
COOKIE_SECURE=true
COOKIE_NAME=rafaela_session
