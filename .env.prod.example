# =============================================================================
# Rafaela – Production / pilot environment template
#
#   cp .env.prod.example .env.prod
#   # fill every CHANGE_ME / empty required value
#   ./scripts/pilot_deploy.sh up
#   ./scripts/pilot_deploy.sh smoke
#
# Never commit .env.prod. Rotate SECRET_KEY / POSTGRES_PASSWORD if leaked.
# =============================================================================

# --- App (required) ---
ENVIRONMENT=production
DEBUG=false
# Keep true for pilot week 1. Flip only after written approval.
DRY_RUN=true
# production always enforces auth even if this is false — set true explicitly.
REQUIRE_AUTH=true
SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_STRING_AT_LEAST_32_CHARS
# Optional dedicated Fernet key (url-safe base64 32 bytes). Empty → derived from SECRET_KEY.
ENCRYPTION_KEY=

# --- Public URLs (required) ---
# Browser origin of the UI
FRONTEND_URL=https://rafaela.example.com
# What the browser uses to call the API (baked into the frontend image at build)
NEXT_PUBLIC_API_URL=https://api.rafaela.example.com
# CORS: JSON list. FRONTEND_URL is added automatically. Loopback is dropped in production.
CORS_ORIGINS=["https://rafaela.example.com"]
COOKIE_SECURE=true
COOKIE_NAME=rafaela_session

# --- LLM ---
# Official Platform key (chat and/or embeddings). Optional if every user uses ChatGPT OAuth
# and you accept no embeddings / no non-OAuth failover.
OPENAI_API_KEY=
OPENAI_BASE_URL=
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=120
# ChatGPT OAuth callback must be reachable by the user's browser (often localhost:1455
# even in pilot if users connect from the same machine; for remote users expose it
# carefully or keep Platform key as primary).
OPENAI_OAUTH_REDIRECT_URI=http://localhost:1455/auth/callback
OPENAI_OAUTH_MODEL=gpt-5.5
# low avoids Codex "Response incomplete: max_time_limit" on long reasoning turns
OPENAI_OAUTH_REASONING_EFFORT=low
# Intent router: simple chat skips tools; domain turns get filtered tools
AGENT_INTENT_ROUTER=true
AGENT_MAX_STEPS=4
# Optional backups
OPENCODE_API_KEY=
OPENCODE_BASE_URL=https://opencode.ai/zen/go/v1
OPENCODE_MODEL=kimi-k3
XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1
XAI_MODEL=grok-3-mini
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_MODEL=gemini-3.6-flash
HERMES_API_KEY=
HERMES_BASE_URL=
HERMES_MODEL=default
OPENAI_FALLBACK_API_KEY=
OPENAI_FALLBACK_MODEL=gpt-4o-mini
# name|model|base_url|ENV_VAR ; …   empty base_url = official OpenAI
LLM_FAILOVER_CHAIN=xai|grok-3-mini|https://api.x.ai/v1|XAI_API_KEY;gemini|gemini-3.6-flash|https://generativelanguage.googleapis.com/v1beta/openai/|GEMINI_API_KEY;opencode|kimi-k3|https://opencode.ai/zen/go/v1|OPENCODE_API_KEY;openai|gpt-4o-mini||OPENAI_API_KEY

# --- Firecrawl (optional research / knowledge_save_page) ---
FIRECRAWL_API_KEY=

# --- Microsoft 365 (integration + optional login) ---
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_TENANT_ID=common
MS_REDIRECT_URI=https://api.rafaela.example.com/api/v1/auth/microsoft/callback
MS_LOGIN_REDIRECT_URI=https://api.rafaela.example.com/api/v1/login/microsoft/callback

# --- Google (integration + optional login) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://api.rafaela.example.com/api/v1/auth/google/callback
GOOGLE_LOGIN_REDIRECT_URI=https://api.rafaela.example.com/api/v1/login/google/callback

# --- Database (required) ---
POSTGRES_USER=secretary
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
POSTGRES_DB=secretary
# Must match password above
DATABASE_URL=postgresql+asyncpg://secretary:CHANGE_ME_STRONG_DB_PASSWORD@db:5432/secretary

# --- Redis ---
REDIS_URL=redis://redis:6379/0
# If you enable requirepass in compose later:
# REDIS_URL=redis://:YOUR_PASSWORD@redis:6379/0

# --- Rate limit (shared via Redis) ---
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60
# Proxies in front of the API. Documented nginx → 1. Cloudflare → nginx → 2.
# 0 behind a proxy makes every user share one bucket (the proxy IP).
TRUSTED_PROXY_HOPS=1

# --- Knowledge / RAG ---
KNOWLEDGE_DIR=/knowledge
QDRANT_URL=http://qdrant:6333
KNOWLEDGE_TOP_K=5
# Needs a real OPENAI_API_KEY for OpenAI embeddings; otherwise hash embedder / keyword.
KNOWLEDGE_EMBED_MODEL=text-embedding-3-small

# --- GDPR ---
DEFAULT_RETENTION_DAYS=30
AUDIT_LOG_RETENTION_DAYS=365
